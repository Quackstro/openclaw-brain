{
    "id": "brain",
    "kind": "memory",
    "name": "Brain 2.0",
    "version": "2026.2.1",
    "description": "Behavioral support system — captures, classifies, and routes thoughts into semantic buckets",
    "uiHints": {
        "embedding.apiKey": {
            "label": "Embedding API Key",
            "sensitive": true,
            "placeholder": "gho_...",
            "help": "API key for embeddings (reuse from doc-RAG)"
        },
        "embedding.model": {
            "label": "Embedding Model",
            "placeholder": "text-embedding-3-small",
            "help": "OpenAI embedding model to use"
        },
        "classifier.model": {
            "label": "Classification Model",
            "placeholder": "anthropic/claude-sonnet-4",
            "help": "LLM model for thought classification"
        },
        "confidenceThreshold": {
            "label": "Confidence Threshold",
            "help": "Minimum confidence to auto-route (0.0-1.0, default 0.80)"
        }
    },
    "configSchema": {
        "type": "object",
        "properties": {
            "embedding": {
                "type": "object",
                "properties": {
                    "provider": {
                        "type": "string",
                        "enum": ["gemini", "openai", "auto"]
                    },
                    "apiKey": {
                        "type": "string"
                    },
                    "model": {
                        "type": "string",
                        "enum": [
                            "text-embedding-3-small",
                            "text-embedding-3-large",
                            "gemini-embedding-001"
                        ]
                    },
                    "baseURL": {
                        "type": "string"
                    }
                },
                "required": [
                    "apiKey"
                ]
            },
            "storage": {
                "type": "object",
                "properties": {
                    "dbPath": {
                        "type": "string"
                    }
                }
            },
            "classifier": {
                "type": "object",
                "properties": {
                    "model": {
                        "type": "string"
                    },
                    "apiKey": {
                        "type": "string"
                    }
                }
            },
            "digests": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "enabled": {
                        "type": "boolean"
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "schedule": {
                        "type": "object",
                        "properties": {
                            "morning": {
                                "type": "object",
                                "properties": {
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "time": {
                                        "type": "string"
                                    },
                                    "maxWords": {
                                        "type": "number"
                                    }
                                }
                            },
                            "midday": {
                                "type": "object",
                                "properties": {
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "time": {
                                        "type": "string"
                                    },
                                    "maxWords": {
                                        "type": "number"
                                    }
                                }
                            },
                            "afternoon": {
                                "type": "object",
                                "properties": {
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "time": {
                                        "type": "string"
                                    },
                                    "maxWords": {
                                        "type": "number"
                                    }
                                }
                            },
                            "night": {
                                "type": "object",
                                "properties": {
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "time": {
                                        "type": "string"
                                    },
                                    "maxWords": {
                                        "type": "number"
                                    }
                                }
                            },
                            "weekly": {
                                "type": "object",
                                "properties": {
                                    "enabled": {
                                        "type": "boolean"
                                    },
                                    "day": {
                                        "type": "string"
                                    },
                                    "time": {
                                        "type": "string"
                                    },
                                    "maxWords": {
                                        "type": "number"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "dnd": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "autoQuiet": {
                        "type": "object",
                        "properties": {
                            "enabled": {
                                "type": "boolean"
                            },
                            "from": {
                                "type": "string"
                            },
                            "to": {
                                "type": "string"
                            }
                        }
                    },
                    "manual": {
                        "type": "boolean"
                    }
                }
            },
            "usageAware": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "enabled": {
                        "type": "boolean"
                    },
                    "backoffThreshold": {
                        "type": "number"
                    }
                }
            },
            "confidenceThreshold": {
                "type": "number"
            },
            "autoCapture": {
                "type": "object",
                "properties": {
                    "enabled": {
                        "type": "boolean"
                    },
                    "level": {
                        "type": "string",
                        "enum": ["off", "facts", "standard", "full"]
                    },
                    "extractionModel": {
                        "type": "string"
                    },
                    "flushAfterTurns": {
                        "type": "number"
                    },
                    "idleFlushMs": {
                        "type": "number"
                    },
                    "maxBufferTurns": {
                        "type": "number"
                    },
                    "bucket": {
                        "type": "string"
                    },
                    "minConfidence": {
                        "type": "number"
                    },
                    "extractionApiKey": {
                        "type": "string"
                    },
                    "gatewayUrl": {
                        "type": "string"
                    }
                }
            },
            "autoRecall": {
                "type": "boolean"
            },
            "autoRecallLimit": {
                "type": "number"
            },
            "autoRecallMinScore": {
                "type": "number"
            },
            "buckets": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "actions": {
                "type": "object",
                "properties": {
                    "enabled": {
                        "type": "boolean"
                    },
                    "gatewayToken": {
                        "type": "string"
                    },
                    "gatewayUrl": {
                        "type": "string"
                    },
                    "timezone": {
                        "type": "string"
                    },
                    "extractionModel": {
                        "type": "string"
                    },
                    "reminder": {
                        "type": "object",
                        "properties": {
                            "enabled": {
                                "type": "boolean"
                            },
                            "nagIntervalMinutes": {
                                "type": "number"
                            },
                            "defaultTime": {
                                "type": "string"
                            }
                        }
                    },
                    "payment": {
                        "type": "object",
                        "properties": {
                            "enabled": {
                                "type": "boolean"
                            },
                            "autoExecuteThreshold": {
                                "type": "number"
                            },
                            "maxAutoExecuteAmount": {
                                "type": "number"
                            }
                        }
                    }
                }
            },
            "search": {
                "type": "object",
                "properties": {
                    "excludeBuckets": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}